rules_version = '2';

// ─── Mijn Spanje Kompas CRM – Firestore security rules ─────────────────────
// De CRM blijft privé: alleen ingelogde Firebase Authentication-gebruikers
// hebben toegang. Een users/{uid}-document is NIET vereist om het CRM te openen.
//
// LET OP: als in hetzelfde Firebase-project andere apps/collecties draaien,
// neem hun bestaande regels over voordat je dit bestand publiceert. Publiceren
// vervangt alle huidige Firestore rules.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Gebruikersprofielen zijn optioneel en worden gebruikt voor namen/rollen.
    // Ze vormen geen extra toegangspoort voor het CRM.
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // CRM-data: alleen toegankelijk voor ingelogde Firebase-gebruikers.
    match /leads/{leadId} {
      allow read, create, update, delete: if signedIn();

      match /activities/{activityId} {
        allow read, create, update, delete: if signedIn();
      }

      match /files/{fileId} {
        allow read, create, update, delete: if signedIn();
      }

      match /partnerLinks/{linkId} {
        allow read, create, update, delete: if signedIn();
      }

      match /tasks/{taskId} {
        allow read, create, update, delete: if signedIn();
      }
    }

    match /partners/{partnerId} {
      allow read, create, update, delete: if signedIn();
    }

    // Voeg hier eventuele bestaande regels voor andere apps in hetzelfde
    // Firebase-project toe voordat je publiceert.
  }
}
