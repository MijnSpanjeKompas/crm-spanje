rules_version = '2';

// ─── Mijn Spanje Kompas CRM – Storage security rules ───────────────────────
// Bestanden zijn alleen toegankelijk voor ingelogde Firebase Auth-gebruikers.
// Een users/{uid}-document in Firestore is niet vereist.

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    match /leads/{leadId}/{fileName} {
      allow read, delete: if signedIn();
      allow create: if signedIn()
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType.matches(
          'application/pdf|image/jpeg|image/png|application/msword|application/vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document'
        );
      allow update: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
