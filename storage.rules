rules_version = '2';

// ─── Mijn Spanje Kompas CRM – Storage security rules ───────────────────────
// Bestanden staan onder leads/{leadId}/{fileId}_{naam}. Alleen actieve
// teamleden (users/{uid} in Firestore) kunnen ze lezen, uploaden en verwijderen.
// Bij het publiceren vraagt Firebase eenmalig toestemming om Firestore te
// raadplegen vanuit Storage-rules: die toestemming is nodig.

service firebase.storage {
  match /b/{bucket}/o {

    function isStaff() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('active', true) == true;
    }

    match /leads/{leadId}/{fileName} {
      allow read, delete: if isStaff();
      allow create: if isStaff()
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType.matches(
          'application/pdf|image/jpeg|image/png|application/msword|application/vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document'
        );
      allow update: if false;
    }

    // Al het andere is dicht.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
